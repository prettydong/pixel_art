{
  "name": "@pixel/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./wafer-spatial": {
      "types": "./wafer-spatial.d.ts",
      "default": "./wafer-spatial.js"
    },
    "./wafer-data": {
      "types": "./wafer-data.d.ts",
      "default": "./wafer-data.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./charts": {
      "types": "./charts.d.ts",
      "default": "./charts.js"
    },
    "./architecture-scene": {
      "types": "./architecture-scene.d.ts",
      "default": "./architecture-scene.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
