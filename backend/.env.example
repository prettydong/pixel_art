# Copy to repository-root .env. System environment takes precedence.
HOST=127.0.0.1
PORT=3000
PIXEL_ORIGIN=http://localhost:3000
# Production: use an absolute data path outside the release directory.
# PIXEL_DATA_DIR=/var/lib/pixel-chat
# PIXEL_MODELS_FILE=/etc/pixel-chat/models.json
# PIXEL_FRONTEND_DIR=/srv/pixel-chat/fronted/dist
TEAM_MODEL_API_KEY=replace-me
# Optional HTTP proxy for model APIs; requires a Node runtime supporting NODE_USE_ENV_PROXY.
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1
# NODE_USE_ENV_PROXY=1
PIXEL_SESSION_DAYS=7
PIXEL_UPLOAD_MB=25
PIXEL_RUN_TIMEOUT_SECONDS=3600
PIXEL_CANCEL_TIMEOUT_SECONDS=5
